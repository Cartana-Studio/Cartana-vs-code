{
    "Rollup Handler": {
        "prefix": "rollupHandler-lua",
        "body": [
            "local http = require(\"socket.http\")",
            "local ltn12 = require(\"ltn12\")",
            "local json = require(\"dkjson\")",
            "",
            "local rollupServer = os.getenv(\"ROLLUP_HTTP_SERVER_URL\")",
            "if not rollupServer then",
            "    error(\"ROLLUP_HTTP_SERVER_URL environment variable is not set\")",
            "end",
            "print(\"HTTP rollup server URL is \" .. rollupServer)",
            "",
            "local function sendPostRequest(endpoint, payload)",
            "    local response_body = {}",
            "    local payload_json = json.encode(payload)",
            "    local res, code, headers, status = http.request {",
            "        url = rollupServer .. endpoint,",
            "        method = \"POST\",",
            "        headers = {",
            "            [\"Content-Type\"] = \"application/json\",",
            "            [\"Content-Length\"] = tostring(#payload_json)",
            "        },",
            "        source = ltn12.source.string(payload_json),",
            "        sink = ltn12.sink.table(response_body)",
            "    }",
            "    return table.concat(response_body), code",
            "end",
            "",
            "local function handleAdvance(data)",
            "    print(\"Received advance request data: \" .. json.encode(data))",
            "    print(\"Adding notice\")",
            "    local notice = { payload = data.payload }",
            "    local response, status = sendPostRequest(\"/notice\", notice)",
            "    print(\"Received notice status: \" .. status .. \", body: \" .. response)",
            "    return \"accept\"",
            "end",
            "",
            "local function handleInspect(data)",
            "    print(\"Received inspect request data: \" .. json.encode(data))",
            "    print(\"Adding report\")",
            "    local report = { payload = data.payload }",
            "    local response, status = sendPostRequest(\"/report\", report)",
            "    print(\"Received report status: \" .. status)",
            "    return \"accept\"",
            "end",
            "",
            "local handlers = {",
            "    advance_state = handleAdvance,",
            "    inspect_state = handleInspect",
            "}",
            "",
            "local finish = { status = \"accept\" }",
            "",
            "while true do",
            "    print(\"Sending finish\")",
            "    local response, status = sendPostRequest(\"/finish\", finish)",
            "    print(\"Received finish status: \" .. status)",
            "    if tonumber(status) == 202 then",
            "        print(\"No pending rollup request, trying again\")",
            "    else",
            "        local rollupRequest = json.decode(response)",
            "        local handler = handlers[rollupRequest.request_type]",
            "        if handler then",
            "            finish.status = handler(rollupRequest.data)",
            "        else",
            "            print(\"Unknown request type: \" .. rollupRequest.request_type)",
            "        end",
            "    end",
            "end"
        ],
        "description": "Rollup handler in Lua"
    }
}