{
    "Rollup Handler": {
        "prefix": "rollupHandler-go",
        "body": [
            "package main",
            "",
            "import (",
            "    \"bytes\"",
            "    \"encoding/json\"",
            "    \"fmt\"",
            "    \"log\"",
            "    \"net/http\"",
            "    \"os\"",
            ")",
            "",
            "var rollupServer = os.Getenv(\"ROLLUP_HTTP_SERVER_URL\")",
            "",
            "func main() {",
            "    if rollupServer == \"\" {",
            "        log.Fatal(\"ROLLUP_HTTP_SERVER_URL environment variable is not set\")",
            "    }",
            "    fmt.Printf(\"HTTP rollup server URL is %s\\n\", rollupServer)",
            "",
            "    finish := map[string]string{\"status\": \"accept\"}",
            "",
            "    for {",
            "        fmt.Println(\"Sending finish\")",
            "        finishResponse, err := sendPostRequest(\"/finish\", finish)",
            "        if err != nil {",
            "            log.Fatalf(\"Failed to send finish: %v\", err)",
            "        }",
            "",
            "        if finishResponse.StatusCode == http.StatusAccepted {",
            "            fmt.Println(\"No pending rollup request, trying again\")",
            "        } else {",
            "            var rollupRequest map[string]interface{}",
            "            if err := json.NewDecoder(finishResponse.Body).Decode(&rollupRequest); err != nil {",
            "                log.Fatalf(\"Failed to parse rollup request: %v\", err)",
            "            }",
            "            finishResponse.Body.Close()",
            "",
            "            requestType := rollupRequest[\"request_type\"].(string)",
            "            data := rollupRequest[\"data\"].(map[string]interface{})",
            "",
            "            switch requestType {",
            "            case \"advance_state\":",
            "                finish[\"status\"] = handleAdvance(data)",
            "            case \"inspect_state\":",
            "                finish[\"status\"] = handleInspect(data)",
            "            default:",
            "                log.Printf(\"Unknown request type: %s\", requestType)",
            "            }",
            "        }",
            "    }",
            "}",
            "",
            "func handleAdvance(data map[string]interface{}) string {",
            "    fmt.Printf(\"Received advance request data: %v\\n\", data)",
            "    fmt.Println(\"Adding notice\")",
            "    notice := map[string]interface{}{",
            "        \"payload\": data[\"payload\"],",
            "    }",
            "    response, err := sendPostRequest(\"/notice\", notice)",
            "    if err != nil {",
            "        log.Printf(\"Failed to send notice: %v\", err)",
            "    } else {",
            "        fmt.Printf(\"Received notice status: %d\\n\", response.StatusCode)",
            "    }",
            "    return \"accept\"",
            "}",
            "",
            "func handleInspect(data map[string]interface{}) string {",
            "    fmt.Printf(\"Received inspect request data: %v\\n\", data)",
            "    fmt.Println(\"Adding report\")",
            "    report := map[string]interface{}{",
            "        \"payload\": data[\"payload\"],",
            "    }",
            "    response, err := sendPostRequest(\"/report\", report)",
            "    if err != nil {",
            "        log.Printf(\"Failed to send report: %v\", err)",
            "    } else {",
            "        fmt.Printf(\"Received report status: %d\\n\", response.StatusCode)",
            "    }",
            "    return \"accept\"",
            "}",
            "",
            "func sendPostRequest(endpoint string, payload interface{}) (*http.Response, error) {",
            "    url := rollupServer + endpoint",
            "    jsonData, err := json.Marshal(payload)",
            "    if err != nil {",
            "        return nil, fmt.Errorf(\"failed to marshal JSON: %w\", err)",
            "    }",
            "    response, err := http.Post(url, \"application/json\", bytes.NewBuffer(jsonData))",
            "    if err != nil {",
            "        return nil, fmt.Errorf(\"failed to send POST request: %w\", err)",
            "    }",
            "    return response, nil",
            "}"
        ],
        "description": "Rollup handler in Go"
    }
}