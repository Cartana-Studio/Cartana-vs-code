{
    "Rollup Handler": {
        "prefix": "rollupHandler-ts",
        "body": [
            "import axios from 'axios';",
            "",
            "const rollupServer = process.env.ROLLUP_HTTP_SERVER_URL;",
            "if (!rollupServer) {",
            "    throw new Error('ROLLUP_HTTP_SERVER_URL environment variable is not set');",
            "}",
            "console.info(`HTTP rollup server URL is ${rollupServer}`);",
            "",
            "async function handleAdvance(data: any): Promise<string> {",
            "    console.info(`Received advance request data:`, data);",
            "    console.info('Adding notice');",
            "    const notice = { payload: data.payload };",
            "    const response = await axios.post(`${rollupServer}/notice`, notice);",
            "    console.info(`Received notice status: ${response.status}, body: ${response.data}`);",
            "    return 'accept';",
            "}",
            "",
            "async function handleInspect(data: any): Promise<string> {",
            "    console.info(`Received inspect request data:`, data);",
            "    console.info('Adding report');",
            "    const report = { payload: data.payload };",
            "    const response = await axios.post(`${rollupServer}/report`, report);",
            "    console.info(`Received report status: ${response.status}`);",
            "    return 'accept';",
            "}",
            "",
            "const handlers: Record<string, (data: any) => Promise<string>> = {",
            "    advance_state: handleAdvance,",
            "    inspect_state: handleInspect",
            "};",
            "",
            "const finish = { status: 'accept' };",
            "",
            "(async function main() {",
            "    while (true) {",
            "        console.info('Sending finish');",
            "        const response = await axios.post(`${rollupServer}/finish`, finish);",
            "        console.info(`Received finish status: ${response.status}`);",
            "        if (response.status === 202) {",
            "            console.info('No pending rollup request, trying again');",
            "        } else {",
            "            const rollupRequest = response.data;",
            "            const handler = handlers[rollupRequest.request_type];",
            "            if (handler) {",
            "                finish.status = await handler(rollupRequest.data);",
            "            } else {",
            "                console.error(`Unknown request type: ${rollupRequest.request_type}`);",
            "            }",
            "        }",
            "    }",
            "})();"
        ],
        "description": "Rollup handler in TypeScript"
    }
}