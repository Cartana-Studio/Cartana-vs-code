{
    "Rollup Handler": {
        "prefix": "rollupHandler-rb",
        "body": [
            "require 'net/http'",
            "require 'json'",
            "",
            "rollup_server = ENV['ROLLUP_HTTP_SERVER_URL']",
            "if rollup_server.nil? || rollup_server.empty?",
            "  raise 'ROLLUP_HTTP_SERVER_URL environment variable is not set'",
            "end",
            "puts \"HTTP rollup server URL is #{rollup_server}\"",
            "",
            "def send_post_request(endpoint, payload)",
            "  uri = URI.join(rollup_server, endpoint)",
            "  http = Net::HTTP.new(uri.host, uri.port)",
            "  http.use_ssl = (uri.scheme == 'https')",
            "  request = Net::HTTP::Post.new(uri.path, { 'Content-Type' => 'application/json' })",
            "  request.body = payload.to_json",
            "  response = http.request(request)",
            "  return response.body, response.code.to_i",
            "end",
            "",
            "def handle_advance(data)",
            "  puts \"Received advance request data: #{data.to_json}\"",
            "  puts 'Adding notice'",
            "  notice = { payload: data['payload'] }",
            "  response, status = send_post_request('/notice', notice)",
            "  puts \"Received notice status: #{status}, body: #{response}\"",
            "  'accept'",
            "end",
            "",
            "def handle_inspect(data)",
            "  puts \"Received inspect request data: #{data.to_json}\"",
            "  puts 'Adding report'",
            "  report = { payload: data['payload'] }",
            "  response, status = send_post_request('/report', report)",
            "  puts \"Received report status: #{status}\"",
            "  'accept'",
            "end",
            "",
            "handlers = {",
            "  'advance_state' => method(:handle_advance),",
            "  'inspect_state' => method(:handle_inspect)",
            "}",
            "",
            "finish = { status: 'accept' }",
            "",
            "loop do",
            "  puts 'Sending finish'",
            "  response, status = send_post_request('/finish', finish)",
            "  puts \"Received finish status: #{status}\"",
            "  if status == 202",
            "    puts 'No pending rollup request, trying again'",
            "  else",
            "    rollup_request = JSON.parse(response)",
            "    handler = handlers[rollup_request['request_type']]",
            "    if handler",
            "      finish[:status] = handler.call(rollup_request['data'])",
            "    else",
            "      puts \"Unknown request type: #{rollup_request['request_type']}\"",
            "    end",
            "  end",
            "end"
        ],
        "description": "Rollup handler in Ruby"
    }
}