{
    "Rollup Handler": {
        "prefix": "rollupHandler-rs",
        "body": [
            "use reqwest::Client;",
            "use serde_json::{json, Value};",
            "use std::env;",
            "use std::error::Error;",
            "",
            "#[tokio::main]",
            "async fn main() -> Result<(), Box<dyn Error>> {",
            "    let rollup_server = env::var(\"ROLLUP_HTTP_SERVER_URL\")",
            "        .expect(\"ROLLUP_HTTP_SERVER_URL environment variable is not set\");",
            "    println!(\"HTTP rollup server URL is {}\", rollup_server);",
            "",
            "    let client = Client::new();",
            "    let mut finish = json!({ \"status\": \"accept\" });",
            "",
            "    loop {",
            "        println!(\"Sending finish\");",
            "        let response = client.post(format!(\"{}/finish\", rollup_server))",
            "            .json(&finish)",
            "            .send()",
            "            .await?;",
            "",
            "        println!(\"Received finish status: {}\", response.status());",
            "        if response.status() == 202 {",
            "            println!(\"No pending rollup request, trying again\");",
            "        } else {",
            "            let rollup_request: Value = response.json().await?;",
            "            let request_type = rollup_request[\"request_type\"].as_str().unwrap_or(\"\");",
            "            let data = &rollup_request[\"data\"];",
            "",
            "            match request_type {",
            "                \"advance_state\" => {",
            "                    finish[\"status\"] = handle_advance(&client, &rollup_server, data).await.into();",
            "                }",
            "                \"inspect_state\" => {",
            "                    finish[\"status\"] = handle_inspect(&client, &rollup_server, data).await.into();",
            "                }",
            "                _ => {",
            "                    eprintln!(\"Unknown request type: {}\", request_type);",
            "                }",
            "            }",
            "        }",
            "    }",
            "}",
            "",
            "async fn handle_advance(client: &Client, rollup_server: &str, data: &Value) -> String {",
            "    println!(\"Received advance request data: {:?}\", data);",
            "    println!(\"Adding notice\");",
            "    let notice = json!({ \"payload\": data[\"payload\"] });",
            "    let response = client.post(format!(\"{}/notice\", rollup_server))",
            "        .json(&notice)",
            "        .send()",
            "        .await;",
            "",
            "    match response {",
            "        Ok(res) => println!(\"Received notice status: {}, body: {:?}\", res.status(), res.text().await.unwrap_or_default()),",
            "        Err(err) => eprintln!(\"Failed to send notice: {}\", err),",
            "    }",
            "    \"accept\".to_string()",
            "}",
            "",
            "async fn handle_inspect(client: &Client, rollup_server: &str, data: &Value) -> String {",
            "    println!(\"Received inspect request data: {:?}\", data);",
            "    println!(\"Adding report\");",
            "    let report = json!({ \"payload\": data[\"payload\"] });",
            "    let response = client.post(format!(\"{}/report\", rollup_server))",
            "        .json(&report)",
            "        .send()",
            "        .await;",
            "",
            "    match response {",
            "        Ok(res) => println!(\"Received report status: {}\", res.status()),",
            "        Err(err) => eprintln!(\"Failed to send report: {}\", err),",
            "    }",
            "    \"accept\".to_string()",
            "}"
        ],
        "description": "Rollup handler in Rust"
    }
}