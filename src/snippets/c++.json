{
    "Rollup Handler": {
        "prefix": "rollupHandler-cpp",
        "body": [
            "#include <iostream>",
            "#include <string>",
            "#include <cstdlib>",
            "#include <nlohmann/json.hpp>",
            "#include <httplib.h>",
            "",
            "using json = nlohmann::json;",
            "",
            "const char* rollupServer = std::getenv(\"ROLLUP_HTTP_SERVER_URL\");",
            "if (!rollupServer) {",
            "    throw std::runtime_error(\"ROLLUP_HTTP_SERVER_URL environment variable is not set\");",
            "}",
            "std::cout << \"HTTP rollup server URL is \" << rollupServer << std::endl;",
            "",
            "std::string handleAdvance(const json& data) {",
            "    std::cout << \"Received advance request data: \" << data.dump() << std::endl;",
            "    std::cout << \"Adding notice\" << std::endl;",
            "    json notice = { {\"payload\", data[\"payload\"]} };",
            "    httplib::Client cli(rollupServer);",
            "    auto res = cli.Post(\"/notice\", notice.dump(), \"application/json\");",
            "    if (res) {",
            "        std::cout << \"Received notice status: \" << res->status << \", body: \" << res->body << std::endl;",
            "    } else {",
            "        std::cerr << \"Failed to send notice\" << std::endl;",
            "    }",
            "    return \"accept\";",
            "}",
            "",
            "std::string handleInspect(const json& data) {",
            "    std::cout << \"Received inspect request data: \" << data.dump() << std::endl;",
            "    std::cout << \"Adding report\" << std::endl;",
            "    json report = { {\"payload\", data[\"payload\"]} };",
            "    httplib::Client cli(rollupServer);",
            "    auto res = cli.Post(\"/report\", report.dump(), \"application/json\");",
            "    if (res) {",
            "        std::cout << \"Received report status: \" << res->status << std::endl;",
            "    } else {",
            "        std::cerr << \"Failed to send report\" << std::endl;",
            "    }",
            "    return \"accept\";",
            "}",
            "",
            "int main() {",
            "    json finish = { {\"status\", \"accept\"} };",
            "    while (true) {",
            "        std::cout << \"Sending finish\" << std::endl;",
            "        httplib::Client cli(rollupServer);",
            "        auto res = cli.Post(\"/finish\", finish.dump(), \"application/json\");",
            "        if (res) {",
            "            std::cout << \"Received finish status: \" << res->status << std::endl;",
            "            if (res->status == 202) {",
            "                std::cout << \"No pending rollup request, trying again\" << std::endl;",
            "            } else {",
            "                json rollupRequest = json::parse(res->body);",
            "                std::string requestType = rollupRequest[\"request_type\"].get<std::string>();",
            "                if (requestType == \"advance_state\") {",
            "                    finish[\"status\"] = handleAdvance(rollupRequest[\"data\"]);",
            "                } else if (requestType == \"inspect_state\") {",
            "                    finish[\"status\"] = handleInspect(rollupRequest[\"data\"]);",
            "                } else {",
            "                    std::cerr << \"Unknown request type: \" << requestType << std::endl;",
            "                }",
            "            }",
            "        } else {",
            "            std::cerr << \"Failed to send finish\" << std::endl;",
            "        }",
            "    }",
            "    return 0;",
            "}"
        ],
        "description": "Rollup handler in C++"
    }
}
